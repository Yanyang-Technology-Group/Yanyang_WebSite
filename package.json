{
  "name": "vite",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/copy-cap.mjs",
    "build:user": "cross-env VERSION=1.0.0 BUILDER=Admin BUILD_ENV=production vite build && node scripts/copy-cap.mjs",
    "build:userdebug": "cross-env VERSION=1.0.0 BUILDER=Admin BUILD_ENV=userdebug vite build --mode userdebug && node scripts/copy-cap.mjs",
    "typecheck": "tsc --noEmit",
    "snapshot:cloudflare": "node scripts/update-cloudflare-snapshot.mjs",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.1.4",
    "cross-env": "^10.1.0",
    "typescript": "^7.0.2",
    "vite": "^7.2.4"
  },
  "dependencies": {
    "@cap.js/widget": "^0.1.56",
    "@phosphor-icons/react": "^2.1.10",
    "@remixicon/react": "^4.9.0",
    "@tailwindcss/vite": "^4.3.1",
    "clsx": "^2.1.1",
    "daisyui": "^5.7.47",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-is": "^19.3.1",
    "react-router-dom": "^7.13.0",
    "recharts": "^3.11.0",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.1",
    "tdesign-icons-react": "^0.6.4",
    "tdesign-react": "^1.18.0"
  }
}
